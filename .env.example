# Server Configuration
PORT=3002
HOST=0.0.0.0

# Database Configuration
# To use Neon DB, provide your Neon connection string here:
# DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# If left commented or empty, the server automatically uses local SQLite (data/expenses.db)
DATABASE_URL=

# Authentication & Admin Account (Optional)
# AUTH_SECRET=change_this_to_a_long_random_secret_string
# If ADMIN_PASSWORD is set before first boot, the Admin account is auto-created and linked to existing data.
# Otherwise, the first visitor completes the one-time Admin Setup in the browser.
# ADMIN_NAME=Shripathi
# ADMIN_EMAIL=admin@example.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
